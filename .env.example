GEMINI_API_KEY=
# Who may use the AI features (sign in with their Flux account).
# Comma-separated emails, or * for every Flux account. Unset = nobody.
SCRIBE_ALLOWED_EMAILS=
# Flux's Supabase JWT secret (same value as in the Flux apps): lets the server
# read Flux accounts once the Flux database is locked down.
SUPABASE_JWT_SECRET=
# Optional: session-signing secret (defaults to one derived from GEMINI_API_KEY)
# SCRIBE_SESSION_SECRET=
# Optional: override the model (defaults to gemini-3.6-flash)
# SCRIBE_MODEL=
# Optional: serve canned data in dev without calling Gemini
# SCRIBE_MOCK=1
